# ---------------------------------------------------------------------------
# zilch environment — every value has a working mainnet default; all optional.
# Copy to .env.local for `vercel dev` / `npm run dev:local`, or set in Vercel.
# These configure the serverless reads only. The browser signs with the user's
# wallet; the relayer credential (an API key or a self-host token) is a server-
# side env read only by the /api/relayer proxy (see README).
# ---------------------------------------------------------------------------

# Mainnet JSON-RPC for the /api reads and fee quotes (server-side only).
# Use an authenticated provider; public endpoints are rate-limited and may prune
# logs. Default: https://ethereum-rpc.publicnode.com
RPC_URL=

# Blacklight ProtocolConfig proxy (C0) — the one pinned address; every other
# contract resolves off it. Set only to follow a future redeploy.
# Default: 0xa75716772c17818A73104344b5A8888ae24ADc03
CONFIG_ADDRESS=

# How far back the TriggerPosted/SharePosted feed scans look (blocks). 5000 by
# default; the scan falls back automatically if a provider rejects the range.
SCAN_BLOCKS=

# Zama confidential-token wrappers registry that token discovery reads.
# Default: Zama's mainnet registry (from the SDK's chain preset).
ZILCH_REGISTRY=

# How many registry entries to surface in the token list. Default: 24
ZILCH_MAX_TOKENS=

# Pin ONE confidential-token pair and skip registry discovery (both required
# together). Addresses of the ERC-7984 confidential token and its ERC-20
# underlying. Leave unset to discover from the registry.
ZILCH_CTOKEN=
ZILCH_UNDERLYING=

# Optional settlement-hook address; enables atomic settlement. With none set,
# zilch falls back to a manual confidentialTransfer after the covenant opens.
ZILCH_HOOK=
ZILCH_HOOK_GAS=

# --- Relayer (confidential-token ops go through the /api/relayer proxy) ---
# The proxy forwards to ZAMA_RELAYER_URL and injects whichever credential below is
# set, so no credential ever reaches the browser. Use ONE of the two setups.

# The relayer the proxy forwards to. Default is Zama's hosted mainnet relayer; set
# it to your own relayer (e.g. https://your-relayer.example.com) if self-hosting.
ZAMA_RELAYER_URL=

# Setup A - Zama's HOSTED relayer: requires an API key (sent as x-api-key).
# Apply at https://forms.gle/jq84zEek1oiv3kBz9. Leave unset if self-hosting.
ZAMA_RELAYER_API_KEY=

# Setup B - your OWN relayer behind a reverse proxy that gates on a shared secret:
# this value is sent as an x-relayer-token header for that proxy to check. No Zama
# API key needed. Leave unset if using Zama's hosted relayer.
RELAYER_TOKEN=
