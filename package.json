{
  "name": "zilch",
  "version": "0.2.0",
  "private": true,
  "description": "A template dapp that pairs Zama confidential amounts with Nillion Blacklight Covenants on Ethereum mainnet: seal a transfer instruction that opens itself when price or time says so, while the amount stays encrypted.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "dev:local": "tsx scripts/dev-server.ts",
    "build": "vite build",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "install-hooks": "lefthook install",
    "deploy": "npm run build && vercel --prod",
    "build:watch": "vite build --watch"
  },
  "dependencies": {
    "@nillion/covenants-sdk": "^0.6.1",
    "@zama-fhe/sdk": "^3.5.1",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.5",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@fhevm/solidity": "^0.13.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/confidential-contracts": "^0.5.3",
    "@types/node": "^24.0.4",
    "@vercel/node": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.24.0",
    "lefthook": "^1.11.14",
    "solc": "0.8.28",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^8.2.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
